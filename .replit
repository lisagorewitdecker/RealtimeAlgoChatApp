modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "chat-app-preview-startup"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "unit-tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-server-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "chat-app-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "banned-room-e2e"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "mockup-clean-typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "key-reset-recovery-e2e"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "idle-profile-registration-e2e"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "reconnect-delivery-e2e"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "playwright-clean-runtime"

[[workflows.workflow]]
name = "chat-app-preview-startup"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "flock -w 900 /tmp/replit-heavy-validation.lock pnpm --filter @workspace/chat-app run validate:preview-startup"

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "flock -w 900 /tmp/replit-heavy-validation.lock pnpm run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "unit-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm test:unit --run"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "api-server-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "flock -w 900 /tmp/replit-heavy-validation.lock pnpm --filter @workspace/api-server run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "chat-app-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "flock -w 900 /tmp/replit-heavy-validation.lock pnpm --filter @workspace/chat-app run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "banned-room-e2e"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "E2E_CHAT_URL=https://$REPLIT_EXPO_DEV_DOMAIN E2E_API_URL=https://$REPLIT_DEV_DOMAIN flock -w 900 /tmp/replit-heavy-validation.lock pnpm --filter @workspace/api-server run test:e2e:banned-room"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "mockup-clean-typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "flock -w 900 /tmp/replit-heavy-validation.lock pnpm run validate:mockup-clean"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "key-reset-recovery-e2e"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "E2E_CHAT_URL=https://$REPLIT_EXPO_DEV_DOMAIN E2E_API_URL=https://$REPLIT_DEV_DOMAIN flock -w 900 /tmp/replit-heavy-validation.lock pnpm --filter @workspace/api-server run test:e2e:key-reset-recovery"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "idle-profile-registration-e2e"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "E2E_CHAT_URL=https://$REPLIT_EXPO_DEV_DOMAIN E2E_API_URL=https://$REPLIT_DEV_DOMAIN flock -w 900 /tmp/replit-heavy-validation.lock pnpm --filter @workspace/api-server run test:e2e:idle-profile-registration"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "reconnect-delivery-e2e"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "E2E_CHAT_URL=https://$REPLIT_EXPO_DEV_DOMAIN E2E_API_URL=https://$REPLIT_DEV_DOMAIN flock -w 900 /tmp/replit-heavy-validation.lock pnpm --filter @workspace/api-server run test:e2e:reconnect-delivery"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "playwright-clean-runtime"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "flock -w 900 /tmp/replit-heavy-validation.lock pnpm --filter @workspace/api-server run test:browser:clean-runtime"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[nix]
channel = "stable-25_05"
packages = ["glib", "nss", "nspr", "atk", "at-spi2-atk", "dbus", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "mesa", "xorg.libxcb", "libxkbcommon", "alsa-lib", "at-spi2-core", "libgbm", "cups", "expat", "libdrm", "pango", "cairo", "fontconfig", "freetype", "systemd", "gtk3", "tesseract", "imagemagick"]

[userenv]

[userenv.shared]
ADMIN_USER_IDS = ""
EXPO_PUBLIC_ADMIN_USER_IDS = ""


[objectStorage]
defaultBucketID = "replit-objstore-6a255b4b-ad2d-4e4e-86dd-174ca70c17f1"
