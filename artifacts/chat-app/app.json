{
  "expo": {
    "name": "RealtimeAlgoChatApp",
    "slug": "chat-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chat-app",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.devalgochat.realtimealgochat",
      "infoPlist": {
        "NSCameraUsageDescription": "RealtimeAlgoChatApp uses your camera for video calls.",
        "NSMicrophoneUsageDescription": "RealtimeAlgoChatApp uses your microphone for voice and video calls."
      }
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      [
        "./plugins/withSentryNativeUpload.js",
        {
          "organization": "lisagorewitdecker-06",
          "project": "react-native"
        }
      ],
      [
        "@clerk/expo",
        {
          "appleSignIn": true
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "backgroundColor": "#0D0D1A"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "aa2a9d45-179a-4ba3-ab19-3a80be1b0bdd"
      }
    }
  }
}
