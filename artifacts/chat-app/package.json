{
  "name": "@workspace/chat-app",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "sh -c 'if [ -n \"$REPLIT_EXPO_SESSION_SECRET\" ]; then mkdir -p \"${__UNSAFE_EXPO_HOME_DIRECTORY:-$HOME/.expo}\" && pnpm exec create-launch login --session \"$REPLIT_EXPO_SESSION_SECRET\" || true; fi' && EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=\"${EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY:-$VITE_CLERK_PUBLISHABLE_KEY}\" EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_REPL_ID=$REPL_ID REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN node scripts/preview-launch-evidence.mjs --launch -- pnpm exec expo start --localhost --port $PORT",
    "build": "node scripts/build.js",
    "eas-build-pre-install": "node scripts/build.js --native-build-preflight",
    "preflight:release": "node scripts/build.js --preflight-only",
    "serve": "node server/serve.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate:preview-runtime": "node scripts/validate-preview-runtime.mjs",
    "test:preview-runtime": "pnpm run validate:preview-runtime",
    "validate:preview-configuration": "node scripts/validate-preview-startup.mjs --validate-configuration",
    "validate:preview-startup": "pnpm run validate:preview-runtime && pnpm run validate:preview-configuration && node scripts/validate-preview-startup.mjs --validate-timeouts && pnpm run test:preview-loader-compatibility && pnpm run test:preview-live-timeout && node scripts/validate-preview-startup.mjs",
    "test": "pnpm run test:keyboard-strategy && jest --passWithNoTests --runInBand && pnpm run test:build-preflight && pnpm run test:branding && pnpm run test:sentry-upload-policy && pnpm run test:preview-runtime && pnpm run test:preview-startup && pnpm run test:request-evidence && pnpm run test:preview-launch-evidence",
    "test:keyboard-strategy": "node --test scripts/validate-keyboard-strategy.test.mjs",
    "test:build-preflight": "node --test scripts/build.test.js",
    "test:sentry-upload-policy": "node --test plugins/withSentryNativeUpload.test.mjs",
    "test:preview-loader-compatibility": "node scripts/validate-preview-startup-runtime-diagnostic.test.mjs",
    "refresh:preview-loader-evidence": "node scripts/refresh-preview-startup-runtime-library-fixture.mjs",
    "test:preview-live-timeout": "node scripts/validate-preview-startup.mjs --validate-timeouts && node --test --test-name-pattern=\"live Metro\" scripts/validate-preview-startup.test.mjs",
    "test:preview-handoff": "node --test --test-name-pattern=\"local .*handoff probe\" scripts/validate-preview-startup.test.mjs",
    "test:preview-preflight": "pnpm run test:preview-loader-compatibility && node --test scripts/validate-preview-startup.test.mjs",
    "test:branding": "node --test scripts/validate-branding.test.mjs",
    "test:preview-startup": "pnpm run test:preview-loader-compatibility && node --test scripts/validate-preview-startup.test.mjs",
    "test:request-evidence": "node scripts/metro-request-evidence.test.mjs && node scripts/save-ios-preview-evidence.test.mjs",
    "test:preview-launch-evidence": "node --test scripts/preview-launch-evidence.test.mjs",
    "probe:preview-launch": "node scripts/preview-launch-evidence.mjs",
    "save:ios-preview-evidence": "node scripts/save-ios-preview-evidence.mjs",
    "validate:branding": "node scripts/validate-branding.mjs",
    "validate:keyboard-strategy": "node scripts/validate-keyboard-strategy.mjs",
    "validate:branding:native": "node scripts/validate-branding.mjs --native",
    "test:native-large-text": "bash e2e/native-large-text/run.sh",
    "test:native-sentry": "bash e2e/sentry-source-map/run.sh"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@clerk/expo": "^4.6.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/cli": "57.0.20",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native/jest-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@sentry/cli": "2.58.4",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "catalog:",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.5",
    "@ungap/structured-clone": "^1.4.0",
    "@workspace/api-client-react": "workspace:*",
    "babel-plugin-react-compiler": "19.0.0-beta-ebf51a3-20250411",
    "create-launch": "0.3.6",
    "expo": "~57.0.24",
    "expo-auth-session": "~57.0.12",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.19",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "typescript": "~6.0.3",
    "zod": "catalog:",
    "zod-validation-error": "^3.5.4"
  },
  "dependencies": {
    "@sentry/react-native": "^7.11.0",
    "react-native-webview": "13.16.1",
    "socket.io-client": "^4.8.3",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  }
}
