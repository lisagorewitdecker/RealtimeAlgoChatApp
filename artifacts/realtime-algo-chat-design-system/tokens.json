{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#0E1118" },
      "foreground": { "$value": "#F4F6FA" },
      "border": { "$value": "#343D4C" },
      "card": { "$value": "#171B24" },
      "cardForeground": { "$value": "#F4F6FA" },
      "popover": { "$value": "#171B24" },
      "popoverForeground": { "$value": "#F4F6FA" },
      "primary": {
        "$value": "#5AA5FA",
        "$description": "Primary brand color. Drives buttons, links, and emphasis."
      },
      "primaryForeground": { "$value": "#FFFFFF" },
      "secondary": { "$value": "#202938" },
      "secondaryForeground": { "$value": "#D8E9FF" },
      "muted": { "$value": "#1C222D" },
      "mutedForeground": { "$value": "#9AA4B5" },
      "accent": { "$value": "#79BAFF" },
      "accentForeground": { "$value": "#0E1118" },
      "destructive": { "$value": "#F97070" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input": { "$value": "#343D4C" },
      "ring": { "$value": "#79BAFF" },
      "chart1": { "$value": "#5AA5FA" },
      "chart2": { "$value": "#55C995" },
      "chart3": { "$value": "#79BAFF" },
      "chart4": { "$value": "#F6C453" },
      "chart5": { "$value": "#F97070" },
      "sidebar": { "$value": "#171B24" },
      "sidebarForeground": { "$value": "#F4F6FA" },
      "sidebarBorder": { "$value": "#343D4C" },
      "sidebarPrimary": { "$value": "#5AA5FA" },
      "sidebarPrimaryForeground": { "$value": "#FFFFFF" },
      "sidebarAccent": { "$value": "#202938" },
      "sidebarAccentForeground": { "$value": "#D8E9FF" },
      "sidebarRing": { "$value": "#79BAFF" }
    },
    "dark": {
      "background": { "$value": "#0E1118" },
      "foreground": { "$value": "#F4F6FA" },
      "border": { "$value": "#343D4C" },
      "card": { "$value": "#171B24" },
      "cardForeground": { "$value": "#F4F6FA" },
      "popover": { "$value": "#171B24" },
      "popoverForeground": { "$value": "#F4F6FA" },
      "primary": { "$value": "#5AA5FA" },
      "primaryForeground": { "$value": "#FFFFFF" },
      "secondary": { "$value": "#202938" },
      "secondaryForeground": { "$value": "#D8E9FF" },
      "muted": { "$value": "#1C222D" },
      "mutedForeground": { "$value": "#9AA4B5" },
      "accent": { "$value": "#79BAFF" },
      "accentForeground": { "$value": "#0E1118" },
      "destructive": { "$value": "#F97070" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input": { "$value": "#343D4C" },
      "ring": { "$value": "#79BAFF" },
      "chart1": { "$value": "#5AA5FA" },
      "chart2": { "$value": "#55C995" },
      "chart3": { "$value": "#79BAFF" },
      "chart4": { "$value": "#F6C453" },
      "chart5": { "$value": "#F97070" },
      "sidebar": { "$value": "#171B24" },
      "sidebarForeground": { "$value": "#F4F6FA" },
      "sidebarBorder": { "$value": "#343D4C" },
      "sidebarPrimary": { "$value": "#5AA5FA" },
      "sidebarPrimaryForeground": { "$value": "#FFFFFF" },
      "sidebarAccent": { "$value": "#202938" },
      "sidebarAccentForeground": { "$value": "#D8E9FF" },
      "sidebarRing": { "$value": "#79BAFF" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "sans-serif"],
        "$description": "Default UI and body typeface."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["Courier New", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.75rem",
      "$description": "Base corner radius; sm/md/lg/xl derive from this in the theme."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
