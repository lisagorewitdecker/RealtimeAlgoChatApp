{
  "name": "@workspace/api-spec",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "codegen": "orval --config ./orval.config.ts && node ./scripts/postprocess-generated.mjs && pnpm -w run typecheck:libs",
    "check-generated": "pnpm run test && node ./scripts/check-generated.mjs",
    "test": "node ./scripts/postprocess-generated.test.mjs && node ./scripts/check-contract-compatibility.test.mjs && node ./scripts/generated-drift-report.test.mjs && node ./scripts/check-staged-codegen-backups.test.mjs && node ./scripts/check-generated.test.mjs"
  },
  "devDependencies": {
    "orval": "^8.27.0"
  }
}
